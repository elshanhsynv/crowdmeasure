<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ backup and device-to-device transfer rules.
   Nothing is backed up or transferred: the databases hold location and network history, and
   the preferences hold the installation ID, which must stay unique to this device.
   android:allowBackup="false" alone does not stop device-to-device transfer on Android 12+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
