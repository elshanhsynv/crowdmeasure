<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower (see data_extraction_rules.xml for Android 12+).
   Backup is disabled via android:allowBackup="false"; these exclusions keep it that way if the
   flag is ever flipped. Location history and the installation ID must not leave the device.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
